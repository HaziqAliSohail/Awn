# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (used by the FastAPI backend; legacy Next /api routes also read it
# during migration — safe to remove once the frontend calls the Python backend)
OPENAI_API_KEY=sk-your-openai-key

# FastAPI backend base URL the browser calls with a Supabase bearer token.
# See /backend. Locally this is the uvicorn server.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Concierge admin allowlist (comma-separated). Mirror this in backend/.env.
ADMIN_EMAILS=you@example.com
