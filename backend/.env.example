# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project JWT secret (Supabase dashboard → Settings → API → JWT Secret).
# Used to verify the access token the browser sends. If your project uses the
# newer asymmetric signing keys, switch verification to JWKS in app/security.py.
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Claude (Anthropic) — scope engine ─────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key
SCOPE_MODEL=claude-haiku-4-5

# ── Google Gemini — embeddings (free key: aistudio.google.com/apikey) ─
GEMINI_API_KEY=your-gemini-key
GEMINI_EMBED_MODEL=text-embedding-004

# ── App ───────────────────────────────────────────────────
# Comma-separated admin emails for the concierge endpoints.
ADMIN_EMAILS=you@example.com
# Comma-separated browser origins allowed by CORS (your Next app).
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
# Public URL of the frontend, used for links inside notification emails/pushes
# (defaults to the first FRONTEND_ORIGINS entry if left blank).
APP_URL=http://localhost:3000

# ── Email notifications (Gmail SMTP) ──────────────────────
# Reuse the same Gmail account + app password you set for Supabase auth SMTP.
# Create an App Password at https://myaccount.google.com/apppasswords (needs
# 2-Step Verification on). Leave SMTP_USER/SMTP_PASSWORD blank to disable email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
SMTP_FROM_NAME=Awn

# ── Web push (VAPID) ──────────────────────────────────────
# Generate a keypair once:  python -m py_vapid --gen  (or: npx web-push generate-vapid-keys)
# Put the PUBLIC key ALSO in the frontend as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Leave blank to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
