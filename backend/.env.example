# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project JWT secret (Supabase dashboard → Settings → API → JWT Secret).
# Used to verify the access token the browser sends. If your project uses the
# newer asymmetric signing keys, switch verification to JWKS in app/security.py.
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Claude (Anthropic) — scope engine ─────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key
SCOPE_MODEL=claude-haiku-4-5

# ── Google Gemini — embeddings (free key: aistudio.google.com/apikey) ─
GEMINI_API_KEY=your-gemini-key
GEMINI_EMBED_MODEL=text-embedding-004

# ── App ───────────────────────────────────────────────────
# Comma-separated admin emails for the concierge endpoints.
ADMIN_EMAILS=you@example.com
# Comma-separated browser origins allowed by CORS (your Next app).
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
