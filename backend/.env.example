# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project JWT secret (Supabase dashboard → Settings → API → JWT Secret).
# Used to verify the access token the browser sends. If your project uses the
# newer asymmetric signing keys, switch verification to JWKS in app/security.py.
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Claude (Anthropic) — scope engine ─────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key
SCOPE_MODEL=claude-haiku-4-5

# ── Google Gemini — embeddings (free key: aistudio.google.com/apikey) ─
GEMINI_API_KEY=your-gemini-key
GEMINI_EMBED_MODEL=text-embedding-004

# ── App ───────────────────────────────────────────────────
# Comma-separated admin emails for the concierge endpoints.
ADMIN_EMAILS=you@example.com
# Comma-separated browser origins allowed by CORS (your Next app).
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
# Public URL of the frontend, used for links inside notification emails/pushes
# (defaults to the first FRONTEND_ORIGINS entry if left blank).
APP_URL=http://localhost:3000

# ── Email notifications ───────────────────────────────────
# PRODUCTION: use Brevo (HTTPS API). Most hosts (Render, etc.) block outbound
# SMTP ports, so raw SMTP times out in the cloud — Brevo sends over HTTPS.
#   1. Sign up free at https://www.brevo.com  (300 emails/day)
#   2. Verify a single sender (Senders & IP → Senders) — no domain needed,
#      just click the confirmation link Brevo emails you.
#   3. Create an API key (SMTP & API → API Keys) and paste it below.
# SMTP_FROM_EMAIL must equal the verified sender; SMTP_FROM_NAME is the display name.
BREVO_API_KEY=xkeysib-your-brevo-api-key
SMTP_FROM_EMAIL=your-verified-sender@gmail.com
SMTP_FROM_NAME=Awn

# LOCAL DEV fallback: Gmail SMTP (works locally; blocked on most cloud hosts).
# Used only when BREVO_API_KEY is blank. App Password from
# https://myaccount.google.com/apppasswords (needs 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# ── Web push (VAPID) ──────────────────────────────────────
# Generate a keypair once:  python -m py_vapid --gen  (or: npx web-push generate-vapid-keys)
# Put the PUBLIC key ALSO in the frontend as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Leave blank to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
